ar(--accent) 4%, #fff); }\n.drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }\n.drop:focus-within { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }\n.drop b { font-weight: 600; }\n.drop small { color: var(--muted); font-size: 13px; }\n.drop svg { width: 28px; height: 28px; color: var(--muted); }\n.thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 10px; margin-top: 10px; }\n.thumbs:empty { display: none; }\n.th { position: relative; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: var(--soft); }\n.th img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.th .noimg { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 12px; color: var(--muted); padding: 6px; text-align: center; }\n.th .num { position: absolute; left: 6px; top: 6px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 11px; background: rgba(0,0,0,.6); color: #fff; font-size: 12px; line-height: 22px; text-align: center; }\n.th .x { position: absolute; right: 4px; top: 4px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; font-size: 18px; line-height: 1; cursor: pointer; }\n.th .x:hover { background: rgba(0,0,0,.8); }\n.th .warn { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(180, 35, 24, .88); color: #fff; font-size: 12px; line-height: 1.2; padding: 4px 6px; }\n.one .thumbs { grid-template-columns: minmax(0, 220px); }\n.up-logo .th img { object-fit: contain; padding: 8px; background: #fff; }\n\n/* Проверка */\n.sum { border: 1.5px solid var(--line); border-radius: var(--radius); margin: 0 0 10px; }\n.sum-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 8px 10px 16px; gap: 8px; }\n.sum-head b { font-size: 15px; }\n.sum dl { margin: 0; padding: 0 16px 12px; font-size: 14px; }\n.sum dt { color: var(--muted); margin-top: 6px; }\n.sum dd { margin: 0; white-space: pre-line; }\n.sum .empty { color: var(--muted); padding: 0 16px 12px; font-size: 14px; margin: 0; }\n\n/* Кнопки внизу */\n.nav { display: flex; gap: 12px; justify-content: space-between; align-items: center; margin-top: 28px; padding-top: 16px; border-top: 1px solid #efeef2; }\n.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; padding: 12px 26px;\n  border-radius: 999px; border: 0; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; transition: filter .15s, background .15s; }\n.btn-main { background: var(--btn); color: var(--btn-text); margin-inline-start: auto; }\n.btn-main:hover { filter: brightness(1.15); }\n.btn-ghost { background: none; color: var(--text); padding-inline: 14px; }\n.btn-ghost:hover { background: var(--soft); }\n.btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }\n.btn[disabled] { opacity: .6; cursor: default; }\n\n/* Начало и конец */\n.hero { text-align: center; margin: auto 0; padding: 24px 0; }\n.hero h1 { font-size: 32px; }\n.hero .lead { max-width: 420px; margin: 10px auto 28px; }\n.facts { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 20px; color: var(--muted); font-size: 14px; margin: 0 0 32px; padding: 0; list-style: none; }\n.facts li::before { content: \"\"; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-inline-end: 8px; vertical-align: middle; }\n.hero .btn-main { margin: 0 auto; min-width: 200px; }\n.check { width: 64px; height: 64px; margin: 0 auto 16px; color: var(--ok); }\n.keybox { display: flex; gap: 8px; margin: 18px 0 8px; text-align: start; }\n.keybox input { flex: 1; font-size: 14px; min-width: 0; }\n.keybox .btn { min-height: 48px; padding: 10px 18px; background: var(--btn); color: var(--btn-text); }\n.note { color: var(--muted); font-size: 14px; }\n.progress { height: 6px; background: var(--soft); border-radius: 6px; overflow: hidden; margin: 14px 0 6px; }\n.progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s; }\n.alert { background: var(--error-bg); color: var(--error); border-radius: 12px; padding: 12px 14px; margin: 16px 0 0; font-size: 15px; }\n.hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }\n\n@media (max-width: 600px) {\n  .card { width: 100%; margin: 0; border-radius: 0; padding: 18px 16px calc(16px + env(safe-area-inset-bottom)); min-height: 100vh; min-height: 100dvh; box-shadow: none; }\n  .bg.has-img + .card { width: calc(100% - 16px); margin: 8px auto; border-radius: 18px; min-height: calc(100dvh - 16px); }\n  h1 { font-size: 24px; }\n  .hero h1 { font-size: 27px; }\n  .bar { margin: 12px 0 20px; }\n  .nav { position: sticky; bottom: 0; background: #fff; margin: 20px -16px 0; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); }\n  .btn-main { flex: 1; }\n  .designs { grid-template-columns: 1fr; }\n  .dz > span { display: flex; gap: 14px; align-items: center; }\n  .dz .sk { width: 92px; flex: none; }\n  .dz b { margin-top: 0; }\n}\n"
