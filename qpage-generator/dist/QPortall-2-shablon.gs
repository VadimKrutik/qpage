"/* QPage - стили. Цвета меняются в content.js (site.theme) или здесь, в :root. */\n\n:root {\n  --accent: #0b6e69;\n  --accent-dark: #084f4b;\n  --accent-soft: #e3f2f1;\n  --text: #1c2326;\n  --muted: #4a5559;\n  --bg: #ffffff;\n  --bg-soft: #f5f7f7;\n  --border: #d4dbdc;\n  --error: #b42318;\n  --error-bg: #fdecea;\n  --ok: #146c2e;\n  --ok-bg: #e7f5ec;\n  --warn-bg: #fff6db;\n  --warn-border: #c79100;\n  --whatsapp: #0d7337;\n  --focus: #1a5fd0;\n  --radius: 12px;\n  --shadow: 0 2px 10px rgba(16, 32, 36, 0.08);\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", \"Noto Sans Hebrew\", Arial, sans-serif;\n  --header-h: 64px;\n}\n\n*, *::before, *::after { box-sizing: border-box; }\n[hidden] { display: none !important; }\n\nhtml {\n  scroll-behavior: smooth;\n  scroll-padding-top: calc(var(--header-h) + 12px);\n  -webkit-text-size-adjust: 100%;\n}\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  * { transition: none !important; }\n}\n\nbody {\n  margin: 0;\n  font-family: var(--font);\n  font-size: 1.0625rem;\n  line-height: 1.6;\n  color: var(--text);\n  background: var(--bg);\n  /* Очень длинные слова и ссылки из анкеты переносятся, а не растягивают страницу. */\n  overflow-wrap: anywhere;\n}\nbody.has-mobile-bar { padding-bottom: 76px; }\n@media (min-width: 900px) { body.has-mobile-bar { padding-bottom: 0; } }\n\nimg { max-width: 100%; height: auto; display: block; }\nh1, h2, h3 { line-height: 1.25; margin: 0 0 0.6em; }\nh2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }\nh3 { font-size: 1.15rem; }\np { margin: 0 0 1em; }\na { color: var(--accent-dark); text-underline-offset: 0.15em; }\na:hover { color: var(--accent); }\n\n:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n  border-radius: 4px;\n}\n\n.icon { width: 1.25em; height: 1.25em; flex: none; vertical-align: -0.25em; }\n.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }\n\n.visually-hidden {\n  position: absolute !important;\n  width: 1px; height: 1px;\n  margin: -1px; padding: 0; border: 0;\n  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;\n}\n\n.container { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: 16px; }\n@media (min-width: 600px) { .container { padding-inline: 24px; } }\n/* Все блоки (прайс, форма, видео, вопросы) - от левой до правой линии сетки.\n   Ограничена только длина строки обычного текста, чтобы его было удобно читать. */\n.narrow p:not(.demo-box) { max-width: 780px; }\n\n/* ---------- Ссылка «к содержанию» и плашка демо ---------- */\n\n.skip-link {\n  position: absolute;\n  inset-inline-start: 12px;\n  top: -100px;\n  z-index: 100;\n  padding: 10px 16px;\n  background: var(--text);\n  color: #fff;\n  border-radius: 8px;\n}\n.skip-link:focus { top: 12px; color: #fff; }\n\n.demo-notice {\n  background: var(--warn-bg);\n  border-bottom: 2px solid var(--warn-border);\n  color: #5c4300;\n  font-size: 0.95rem;\n  font-weight: 700;\n  text-align: center;\n}\n.demo-notice p { margin: 0; padding: 8px 16px; }\n\n/* ---------- Шапка ---------- */\n\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  background: var(--bg);\n  border-bottom: 1px solid var(--border);\n}\n/* Шапка в три колонки: название | языки | меню. Языки всегда ровно посередине -\n   при переключении на иврит они не перепрыгивают из угла в угол. */\n.header-inner {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n  min-height: var(--header-h);\n}\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--text);\n  text-decoration: none;\n  font-weight: 700;\n  font-size: 1.1rem;\n  grid-column: 1;\n  grid-row: 1;\n  justify-self: start;\n  max-width: 100%;\n  min-width: 0;\n}\n.brand-logo { width: 40px; height: 40px; object-fit: contain; }\n/* Логотип-надпись (широкий): по высоте, без квадрата; название рядом не повторяем */\n.brand-logo.is-wide { width: auto; height: 32px; max-width: 110px; }\n.logo-wide .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n@media (min-width: 700px) { .brand-logo.is-wide { height: 36px; max-width: 200px; } }\n.brand-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n/* На очень узких экранах название остаётся только для экранных дикторов: оно есть на первом экране */\n@media (max-width: 699px) {\n  .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n}\n\n.site-nav ul { list-style: none; margin: 0; padding: 0; }\n.site-nav a {\n  display: block;\n  padding: 10px 12px;\n  color: var(--text);\n  text-decoration: none;\n  border-radius: 8px;\n}\n.site-nav a:hover { background: var(--accent-soft); color: var(--accent-dark); }\n\n.menu-toggle {\n  grid-column: 3;\n  grid-row: 1;\n  justify-self: end;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px; height: 44px;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--bg);\n  color: var(--text);\n  cursor: pointer;\n}\n.menu-toggle .icon { width: 24px; height: 24px; }\n\n/* Меню на телефоне: раскрывается под шапкой */\n@media (max-width: 899px) {\n  .site-nav {\n    display: none;\n    position: absolute;\n    top: 100%;\n    inset-inline: 0;\n    background: var(--bg);\n    border-bottom: 1px solid var(--border);\n    box-shadow: var(--shadow);\n    padding: 8px 16px 16px;\n  }\n  .menu-open .site-nav { display: block; }\n  .site-nav a { padding: 12px; font-size: 1.1rem; }\n}\n@media (min-width: 900px) {\n  .menu-toggle { display: none; }\n  /* На компьютере меню - второй строкой шапки (в одну строку с языками оно не помещается). */\n  html { scroll-padding-top: 120px; }\n  .header-inner { grid-template-columns: auto 1fr; padding-block: 8px 4px; row-gap: 4px; }\n  /* Название с логотипом - по центру по высоте обоих рядов (языки и меню). */\n  .brand { grid-row: 1 / 3; align-self: center; }\n  /* Языки и меню прижаты к правой линии сетки - той же, где кончаются кнопки, фото и блоки. */\n  .site-nav { grid-column: 2; grid-row: 2; justify-self: end; }\n  .site-nav ul { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }\n  .site-nav a { padding: 6px 12px; }\n  .header-inner .lang-switch { justify-self: end; }\n  /* Длинное название в шапке обрезается многоточием: полностью оно стоит в цветном блоке. */\n  .brand-name { max-width: 380px; }\n}\n\n.lang-switch {\n  grid-column: 2;\n  grid-row: 1;\n  justify-self: center;\n  /* Порядок RU · HE · EN одинаковый на всех языках, и на иврите тоже */\n  direction: ltr;\n  display: flex;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  overflow: hidden;\n  flex: none;\n}\n.lang-switch button {\n  min-width: 44px;\n  min-height: 44px;\n  padding: 0 8px;\n  border: 0;\n  background: var(--bg);\n  color: var(--text);\n  font: inherit;\n  font-size: 0.9rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n.lang-switch button:not([hidden]) ~ button { border-inline-start: 1px solid var(--border); }\n.lang-switch button:hover { background: var(--accent-soft); }\n.lang-switch button[aria-pressed=\"true\"] { background: var(--accent); color: #fff; }\n.lang-switch button:focus-visible { outline-offset: -3px; }\n\n/* ---------- Кнопки ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 48px;\n  padding: 10px 20px;\n  border: 2px solid transparent;\n  border-radius: 10px;\n  font: inherit;\n  font-weight: 600;\n  line-height: 1.2;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* Слова на кнопках переносим только целиком (иначе «Позвонит-ь» на узком телефоне). */\n  overflow-wrap: normal;\n}\n.btn-primary { background: var(--accent); color: #fff; }\n.btn-primary:hover { background: var(--accent-dark); color: #fff; }\n.btn-secondary { background: var(--bg); color: var(--accent-dark); border-color: var(--accent); }\n.btn-secondary:hover { background: var(--accent-soft); color: var(--accent-dark); }\n.btn-whatsapp { background: var(--whatsapp); color: #fff; }\n.btn-whatsapp:h",
"over { background: #095a2b; color: #fff; }\n.btn:disabled { opacity: 0.6; cursor: progress; }\n\n/* ---------- Первый экран ---------- */\n\n/* Одинаковый во всех версиях. Сверху - цветная заливка: фото владельца слева, по центру три строки\n   (вид деятельности, название, преимущества). Ниже - «Где работаем» слева и кнопки справа, под ними главное\n   предложение, ещё ниже - главное фото крупно. */\n.hero { padding: 0 0 36px; background: var(--bg); }\n@media (min-width: 700px) { .hero { padding-bottom: 56px; } }\n.hero-banner {\n  display: flex;\n  align-items: center;\n  min-height: clamp(200px, 36vh, 400px);\n  padding: 40px 0;\n  background: linear-gradient(135deg, var(--accent), var(--accent-dark));\n  color: #fff;\n}\n/* Три колонки: фото - у левого края, текст - ровно по центру блока (третья колонка уравновешивает первую).\n   Крайние колонки - по размеру фото: длинное название не сжимает фото в овал. */\n.hero-banner > .container {\n  --pw: 120px;\n  width: 100%;\n  display: grid;\n  grid-template-columns: var(--pw) minmax(0, 1fr) var(--pw);\n  align-items: center;\n  column-gap: 24px;\n  text-align: center;\n}\n.hero-banner h1,\n.hero-banner .hero-facts { grid-column: 2; }\n.hero-portrait {\n  grid-column: 1;\n  grid-row: 1 / 3;\n  justify-self: start;\n  width: var(--pw);\n  height: var(--pw);\n  max-width: none;\n  border-radius: 50%;\n  object-fit: cover;\n  border: 4px solid rgba(255, 255, 255, 0.85);\n}\n.hero-kind {\n  display: block;\n  margin: 0 0 4px;\n  line-height: 1.5;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  font-size: 0.9rem;\n  opacity: 0.9;\n}\n.hero h1 { font-size: clamp(2rem, 1.5rem + 2.5vw, 3.25rem); margin: 0 0 0.3em; color: #fff; text-wrap: balance; }\n/* Длинное название (больше 30 знаков) - мельче, чтобы не занимало три строки. */\n.hero.long-name h1 { font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.4rem); }\n.hero-facts {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 8px 20px;\n}\n.hero-facts li { display: flex; align-items: center; gap: 6px; font-weight: 500; }\n/* Копия преимуществ под заливкой - только на телефоне (в заливке там лишь фото и название). */\n.hero-facts-below { display: none; }\n.hero-facts .icon { color: #fff; }\n/* «Где работаем» - у начала строки, кнопки - у конца; на узком экране кнопки переносятся вниз. */\n.hero-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; padding-top: 24px; }\n.hero-more .hero-areas { margin: 0; }\n.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }\n.hero-tagline { margin: 24px 0 0; font-size: 1.15rem; color: var(--text); }\n/* Главное фото - крупно, во всю ширину страницы (края совпадают с остальными блоками), не выше экрана.\n   Рамка постоянной формы (без сдвига при загрузке); фото внутри целиком, не обрезается.\n   Если фото другой формы (например вертикальное с телефона), по бокам - та же картинка, размытая. */\n.hero-photo-box {\n  position: relative;\n  aspect-ratio: 16 / 9;\n  max-height: 85vh;\n  margin: 32px 0 0;\n  overflow: hidden;\n  border-radius: var(--radius);\n  background: var(--bg-soft);\n}\n.hero-photo-bg {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  filter: blur(28px) saturate(1.15);\n  transform: scale(1.2);\n  opacity: 0.9;\n}\n.hero-photo {\n  position: relative;\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n/* Телефон: фото владельца слева, три строки - справа от него, по центру оставшегося места. */\n@media (max-width: 699px) {\n  .hero-banner > .container { --pw: 80px; grid-template-columns: var(--pw) minmax(0, 1fr); column-gap: 16px; }\n  .has-portrait .hero-banner h1,\n  .has-portrait .hero-banner .hero-facts { grid-column: 2; }\n  .hero:not(.has-portrait) .hero-banner > .container { grid-template-columns: 1fr; }\n  .hero:not(.has-portrait) .hero-banner h1,\n  .hero:not(.has-portrait) .hero-banner .hero-facts { grid-column: 1; }\n  .hero-portrait { border-width: 3px; }\n  /* Две кнопки под «Где работаем» - одинаковой ширины, во всю строку. */\n  .hero-actions { width: 100%; }\n  .hero-actions .btn { flex: 1 1 0; }\n  .hero h1 { font-size: 1.9rem; }\n  .hero.long-name h1 { font-size: 1.45rem; }\n  .hero-banner { min-height: 0; padding: 24px 0; }\n  .hero-banner .hero-facts { display: none; }\n  .hero-banner > .container { row-gap: 0; }\n  .hero-facts-below { display: flex; justify-content: flex-start; gap: 6px 16px; padding-top: 16px; color: var(--text); font-size: 0.95rem; }\n  .hero-facts-below .icon { color: var(--accent); }\n  .hero-more { padding-top: 16px; }\n  .hero-tagline { margin-top: 16px; }\n  .hero-photo-box { margin-top: 24px; aspect-ratio: 4 / 3; }\n}\n@media (min-width: 700px) {\n  .hero-banner { padding: 56px 0; }\n  .hero-banner > .container { --pw: 160px; }\n}\n\n/* ---------- Секции ---------- */\n\n.section { padding: 36px 0; }\n.section-soft { background: var(--bg-soft); }\n/* Последний элемент блока без нижнего поля: промежутки между всеми блоками одинаковые (только отступ секции). */\n.section > .container > :not(:has(~ :not([hidden]))),\n.section > .container > :not(:has(~ :not([hidden]))) > :not(:has(~ :not([hidden]))),\n.steps li:last-child { margin-bottom: 0; }\n@media (min-width: 700px) { .section { padding: 56px 0; } }\n.prose p:last-child { margin-bottom: 0; }\n\n.cards {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 16px;\n  /* auto-fit: 2-3 карточки растягиваются на всю ширину, а не жмутся к одному краю. */\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));\n}\n.card {\n  /* Без боковых отступов: текст карточки начинается на общей линии всех блоков. */\n  display: flex;\n  flex-direction: column;\n  padding: 16px 0 0;\n  border-top: 3px solid var(--accent);\n}\n.card p { color: var(--muted); }\n.card .card-price { margin: auto 0 0; color: var(--text); font-weight: 700; }\n\n.gallery {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 16px;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));\n}\n.gallery figure { margin: 0; position: relative; }\n.gallery img {\n  /* Все рамки одного размера (ровная сетка), фото внутри - целиком, без обрезки;\n     свободные края рамки залиты спокойным фоном. */\n  display: block;\n  width: 100%;\n  height: auto;\n  aspect-ratio: 4 / 3;\n  object-fit: contain;\n  border-radius: var(--radius);\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n}\n.gallery figcaption {\n  /* Название - поверх нижнего края фото на затемнении. Плитки одной высоты, мозаика не разъезжается. */\n  position: absolute;\n  inset: auto 0 0 0;\n  padding: 32px 12px 10px;\n  border-radius: 0 0 var(--radius) var(--radius);\n  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.62));\n  color: #fff;\n  font-size: 0.95rem;\n  font-weight: 600;\n  line-height: 1.3;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);\n}\n/* Цена - белым ярлычком в верхнем углу фото, на всех плитках одинаково. */\n.gallery .photo-price {\n  position: absolute;\n  top: 10px;\n  inset-inline-end: 10px;\n  padding: 3px 10px;\n  border-radius: 999px;\n  background: #fff;\n  color: var(--text);\n  font-size: 0.95rem;\n  font-weight: 700;\n  white-space: nowrap;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);\n}\n\n/* ---------- Лицензии, прайс, шаги, отзывы, видео ---------- */\n\n.check-list { list-style: none; margin: 0 0 20px; padding: 0; }\n.check-list li { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 10px; }\n.check-list .icon { color: var(--accent); flex: none; margin-top: 0.25em; }\n\n/* Фото документов (лицензии, дипломы): ровные маленькие рамки, документ целиком. */\n.doc-photos { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }\n.doc-photos img {\n  width: 140px;\n  height: auto;\n  aspect-ratio: 3 / 4;\n  object-fit: contain;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  background: var(--bg-soft);\n}\n.doc-photos a:hover img { border-color: var(--accent); }\n\n.price-table { w",
"idth: 100%; border-collapse: collapse; margin-bottom: 12px; }\n.price-table th, .price-table td { padding: 12px 0; border-bottom: 1px solid var(--border); text-align: start; vertical-align: top; }\n.price-table th[scope=\"row\"] { font-weight: 500; }\n.price-table td { text-align: end; font-weight: 700; white-space: nowrap; padding-inline-start: 16px; }\n.price-table .price-group th { padding-top: 24px; color: var(--accent-dark); font-weight: 700; border-bottom: 2px solid var(--accent); }\n#pricelist .btn { margin-top: 8px; }\n\n/* Маркеры: малиновые галочки («Коротко о нас») и кружки без значка (цены) */\n.dot { flex: none; width: 6px; height: 6px; margin-top: 0.62em; border-radius: 50%; background: var(--accent); }\n.dot-item { display: flex; gap: 12px; align-items: flex-start; }\n.card .dot, .price-table .dot { display: none; }\n/* На телефоне одиночные кнопки блоков - во всю ширину, от линии до линии. */\n@media (max-width: 599px) {\n  main .section .btn:not(.video-box .btn, .map-box .btn) { width: 100%; }\n}\n.dot-item > .icon { color: var(--accent); width: 1.45em; height: 1.45em; margin-top: 0.05em; }\n\n.steps { list-style: none; margin: 0; padding: 0; counter-reset: step; }\n.steps li {\n  position: relative;\n  counter-increment: step;\n  min-height: 40px;\n  padding-inline-start: 56px;\n  margin-bottom: 20px;\n  padding-top: 6px;\n}\n.steps li::before {\n  content: counter(step);\n  position: absolute;\n  inset-inline-start: 0;\n  top: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px; height: 40px;\n  border-radius: 50%;\n  background: var(--accent);\n  color: #fff;\n  font-weight: 700;\n}\n\n/* Отзывы - свёрнутым списком: имя и начало текста в одну строку, весь отзыв - по нажатию. */\n.reviews .review summary { justify-content: flex-start; font-weight: 400; min-width: 0; }\n.review-name { flex: none; font-weight: 700; }\n.review-preview { flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--muted); }\n.reviews .review summary::after { margin-inline-start: auto; }\n.reviews .review[open] .review-preview { display: none; }\n.review blockquote { margin: 0; }\n.review blockquote p { margin: 0; }\n\n.video-box {\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  overflow: hidden;\n  background: var(--bg-soft);\n  min-height: 200px;\n}\n/* До нажатия - тёмный кадр 16:9 с кнопкой, как у плеера: видно, что здесь видео. */\n.video-box:not(:has(iframe)) { background: #1c2124; border-color: #1c2124; }\n.video-box .map-placeholder { min-height: 220px; padding-block: 40px; background: none; color: #e8ecee; }\n.video-box iframe { width: 100%; height: auto; aspect-ratio: 16 / 9; border: 0; display: block; }\n\n.accordion details { border-bottom: 1px solid var(--border); }\n.accordion details:first-child { border-top: 1px solid var(--border); }\n.accordion summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  cursor: pointer;\n  padding: 16px 0;\n  font-weight: 600;\n  list-style: none;\n}\n.accordion summary::-webkit-details-marker { display: none; }\n/* Знак «+» в конце строки, у открытого вопроса - «−». */\n.accordion summary::after { content: \"+\"; flex: none; font-size: 1.4rem; line-height: 1; color: var(--accent); }\n.accordion details[open] summary::after { content: \"\\2212\"; }\n.accordion summary:hover { color: var(--accent-dark); }\n.details-body { padding: 0 0 8px; }\n\n/* ---------- Контакты ---------- */\n\n.contacts-grid { display: grid; gap: 32px; }\n@media (min-width: 800px) { .contacts-grid { grid-template-columns: 1fr 1fr; } }\n.contact-list { margin: 0; }\n.contact-list > div { padding: 12px 0; border-bottom: 1px solid var(--border); }\n.contact-list dt { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 0.95rem; }\n.contact-list dt .icon { color: var(--accent); }\n.contact-list dd { margin: 4px 0 0; font-size: 1.15rem; font-weight: 600; }\n.contact-actions { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); }\n\n/* ---------- Карта ---------- */\n\n.address { display: flex; align-items: flex-start; gap: 8px; font-size: 1.15rem; font-weight: 600; }\n.address .icon { color: var(--accent); margin-top: 0.2em; }\n.map-links { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }\n.map-box {\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  overflow: hidden;\n  background: var(--bg);\n  width: 100%;\n  height: 320px;\n}\n@media (min-width: 700px) { .map-box { height: 420px; } }\n.map-box iframe { width: 100%; height: 100%; border: 0; display: block; }\n.map-placeholder {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 24px;\n  text-align: center;\n  color: var(--muted);\n  background:\n    repeating-linear-gradient(45deg, transparent 0 22px, rgba(11, 110, 105, 0.05) 22px 44px),\n    var(--bg);\n}\n\n/* ---------- Форма ---------- */\n\n.badge {\n  display: inline-block;\n  vertical-align: middle;\n  margin-inline-start: 8px;\n  padding: 2px 10px;\n  border: 1px solid var(--warn-border);\n  border-radius: 999px;\n  background: var(--warn-bg);\n  color: #5c4300;\n  font-size: 0.8rem;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n.demo-box {\n  padding: 12px 16px;\n  border-inline-start: 4px solid var(--warn-border);\n  border-radius: 8px;\n  background: var(--warn-bg);\n}\n\n.field { margin-bottom: 18px; }\n/* На широком экране форма во всю ширину: имя, телефон и почта в один ряд, остальное ниже. */\n@media (min-width: 800px) {\n  #contact-form { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 24px; align-items: start; }\n  #contact-form > * { grid-column: 1 / -1; }\n  #contact-form > .field:has(#f-name, #f-phone, #f-email) { grid-column: auto; }\n  #contact-form > button { justify-self: start; }\n}\n.field label { display: block; margin-bottom: 6px; font-weight: 600; }\n.req { color: var(--error); }\n.field input[type=\"text\"],\n.field input[type=\"tel\"],\n.field input[type=\"email\"],\n.field textarea {\n  width: 100%;\n  padding: 12px 14px;\n  border: 1.5px solid #8a9699;\n  border-radius: 10px;\n  background: var(--bg);\n  color: var(--text);\n  font: inherit;\n}\n/* Телефон и почта вводятся слева направо, но выравниваются по направлению страницы */\n[dir=\"rtl\"] .field input[type=\"tel\"],\n[dir=\"rtl\"] .field input[type=\"email\"] { text-align: right; }\n.field textarea { resize: vertical; min-height: 120px; }\n.field input:focus-visible, .field textarea:focus-visible { border-color: var(--focus); outline-offset: 0; }\n.field [aria-invalid=\"true\"] { border-color: var(--error); background: var(--error-bg); }\n.field-hint { margin: 4px 0 0; color: var(--muted); font-size: 0.92rem; }\n.field-error { margin: 4px 0 0; color: var(--error); font-weight: 600; font-size: 0.95rem; }\n.field-error:empty { display: none; }\n\n.field-check { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; align-items: start; }\n.field-check input { width: 24px; height: 24px; margin: 2px 0 0; accent-color: var(--accent); }\n.field-check label { font-weight: 400; margin: 0; }\n.field-check .field-error { grid-column: 1 / -1; }\n\n.error-summary {\n  margin-bottom: 20px;\n  padding: 14px 18px;\n  border: 2px solid var(--error);\n  border-radius: 10px;\n  background: var(--error-bg);\n}\n.error-summary p { margin: 0 0 6px; font-weight: 700; }\n.error-summary ul { margin: 0; padding-inline-start: 20px; }\n.error-summary a { color: var(--error); }\n\n.hp { position: absolute; inset-inline-start: -9999px; width: 1px; height: 1px; overflow: hidden; }\n\n.form-result:empty, #qr-share-status:empty { display: none; }\n.form-wa { margin-top: 14px; }\n.form-wa p { margin: 0 0 8px; }\n.form-result { margin-top: 20px; padding: 14px 18px; border-radius: 10px; font-weight: 600; }\n.form-result.is-demo { background: var(--warn-bg); border: 2px solid var(--warn-border); }\n.form-result.is-ok { background: var(--ok-bg); border: 2px solid var(--ok); color: var(--ok); }\n.form-result.is-error { backg",
"round: var(--error-bg); border: 2px solid var(--error); color: var(--error); }\n\n/* ---------- QR ---------- */\n\n.qr-inner { display: grid; gap: 24px; align-items: center; }\n@media (min-width: 700px) { .qr-inner { grid-template-columns: auto 1fr; gap: 40px; } }\n.qr-code {\n  width: 200px;\n  height: 200px;\n  padding: 8px;\n  background: #fff;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n}\n.qr-code svg { width: 100%; height: 100%; display: block; }\n.qr-actions { display: flex; flex-wrap: wrap; gap: 12px; }\n.qr-actions .btn { margin: 0; }\n.hero-areas { margin: 0; font-size: 1.05rem; color: var(--accent-dark); }\n/* Без значка и плашки: слова «Где работаем?» начинаются на общей линии всех блоков. */\n.text-link { font-weight: 600; }\n.qr-url { font-size: 0.95rem; color: var(--muted); word-break: break-all; }\n\n/* ---------- Конфиденциальность и подвал ---------- */\n\n.privacy-more { margin-top: 16px; }\n.privacy-more > summary {\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  padding: 8px 18px;\n  border: 2px solid var(--accent);\n  border-radius: 999px;\n  color: var(--accent-dark);\n  font-weight: 700;\n  cursor: pointer;\n  list-style: none;\n}\n.privacy-more > summary::-webkit-details-marker { display: none; }\n.privacy-more > summary::after { content: \"▾\"; margin-inline-start: 8px; }\n.privacy-more[open] > summary::after { content: \"▴\"; }\n.privacy-more > summary:hover { background: var(--accent-soft); }\n.privacy-list { padding-inline-start: 22px; margin-top: 16px; }\n.privacy-list li { margin-bottom: 10px; }\n\n.site-footer { background: #142024; color: #dfe7e8; padding: 32px 0; font-size: 0.95rem; }\n.site-footer a { color: #fff; }\n.footer-inner { display: flex; flex-wrap: wrap; gap: 8px 32px; }\n.footer-inner p { margin: 0; }\n/* Подпись QPage - отдельной строкой под чертой, в начале строки */\n.footer-made { margin-top: 20px; }\n/* Линия - ровно по краям текста (не заходит на внутренние отступы). */\n.footer-made p { padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.18); }\n.footer-made p { margin: 0; }\n.made-with a { display: inline-flex; align-items: center; gap: 8px 10px; flex-wrap: wrap; text-decoration: none; color: inherit; }\n/* Логотип QPortall: слово с засечками, «Q» малиновая #FB01F2 (RGB 251-1-242), на тёмном подвале «Portall» белым. */\n.qpage-mark { font-family: Georgia, \"Times New Roman\", serif; font-size: 1.3em; line-height: 1; color: #fff; margin-inline: 2px; }\n.qpage-q { color: #fb01f2; }\n/* «Заказать сайт» - небольшая кнопка рядом с логотипом */\n.made-with a[href] .made-with-order { display: inline-block; color: #fff; border: 1px solid #fff; border-radius: 8px; padding: 6px 12px; line-height: 1.2; font-weight: 600; }\n.made-with a[href]:hover .made-with-order { background: #fff; color: #142024; }\n\n.noscript { padding: 12px 16px; background: var(--warn-bg); }\n\n/* ---------- Панель действий на телефоне ---------- */\n\n.mobile-bar {\n  position: fixed;\n  inset-inline: 0;\n  bottom: 0;\n  z-index: 40;\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: minmax(0, 1fr);\n  gap: 8px;\n  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));\n  background: var(--bg);\n  border-top: 1px solid var(--border);\n  box-shadow: 0 -2px 10px rgba(16, 32, 36, 0.08);\n}\n.mobile-bar .btn { min-width: 0; padding-inline: 8px; gap: 6px; }\n@media (min-width: 900px) { .mobile-bar { display: none; } }\n\n@media print {\n  .site-header, .mobile-bar, .skip-link, .map-box, .video-box, #form { display: none; }\n}\n\n/* Пока скрипт переводит страницу на язык посетителя (скрипт выбора языка в <head> index.html) - не показываем её, чтобы не «прыгала». */\n.lang-wait body { visibility: hidden; }\n\n/* =====================================================================\n   Версии внешнего вида: html[data-design]. Всё одинаковое, кроме одного блока\n   сразу после первого экрана (порядок блоков - core.js, DESIGNS).\n   ===================================================================== */\n\n/* «Витрина»: мозаика фото (фото с первого экрана в ней не повторяются):\n   два в ряд, два в ряд, одно во всю ширину, два в ряд, одно во всю ширину (и так далее). */\n/* Фото без рамок, вплотную друг к другу, заполняют свою клетку. */\n[data-design=\"showcase\"] .gallery { grid-template-columns: 1fr 1fr; gap: 6px; }\n[data-design=\"showcase\"] .gallery img { border: 0; border-radius: 0; background: none; object-fit: cover; }\n[data-design=\"showcase\"] .gallery figcaption { border-radius: 0; }\n/* На узкой плитке телефона цена - над названием, чтобы название не сжималось в три строки. */\n[data-design=\"showcase\"] .gallery > li:nth-child(8n+5),\n[data-design=\"showcase\"] .gallery > li:nth-child(8n+8) { grid-column: 1 / -1; }\n[data-design=\"showcase\"] .gallery > li:nth-child(8n+5) img,\n[data-design=\"showcase\"] .gallery > li:nth-child(8n+8) img { aspect-ratio: 16 / 9; }\n/* Последнее фото, оставшееся в ряду одно, - во всю ширину, без дыры рядом. */\n[data-design=\"showcase\"] .gallery > li:last-child:is(:nth-child(8n+1), :nth-child(8n+3), :nth-child(8n+6)) { grid-column: 1 / -1; }\n[data-design=\"showcase\"] .gallery > li:last-child:is(:nth-child(8n+1), :nth-child(8n+3), :nth-child(8n+6)) img { aspect-ratio: 16 / 9; }\n@media (min-width: 700px) { [data-design=\"showcase\"] .gallery { gap: 10px; } }\n\n/* «Строгий»: «Ваш главный текст» - большой текст сразу после первого экрана. */\n/* «Ваш главный текст» - шириной с большое фото (просьба Vadim). */\n#story .narrow p { max-width: none; }\n.story-text p { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.25rem); line-height: 1.8; margin: 0 0 1em; }\n.story-text p:last-child { margin-bottom: 0; }\n"
