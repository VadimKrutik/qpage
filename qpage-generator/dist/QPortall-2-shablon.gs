"false\"><use href=\"#i-doc\"/></svg>\n          <span data-i18n=\"credentials.link\"></span>\n        </a>\n      </div>\n    </section>\n\n    <!-- Блок 4: услуги и товары -->\n    <section class=\"section section-soft\" id=\"services\" data-block=\"services\" aria-labelledby=\"services-title\">\n      <div class=\"container\">\n        <h2 id=\"services-title\" data-i18n=\"services.title\"></h2>\n        <ul class=\"cards\" id=\"services-list\"></ul>\n      </div>\n    </section>\n\n    <!-- Прайс-лист -->\n    <section class=\"section\" id=\"pricelist\" data-block=\"pricelist\" aria-labelledby=\"pricelist-title\">\n      <div class=\"container narrow\">\n        <h2 id=\"pricelist-title\" data-i18n=\"pricelist.title\"></h2>\n        <table class=\"price-table\" id=\"price-table\">\n          <caption class=\"visually-hidden\" data-i18n=\"pricelist.title\"></caption>\n          <tbody id=\"price-rows\"></tbody>\n        </table>\n        <p class=\"field-hint\" id=\"pricelist-note\" data-i18n=\"pricelist.note\"></p>\n        <a class=\"btn btn-secondary\" id=\"pricelist-link\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#i-doc\"/></svg>\n          <span data-i18n=\"pricelist.link\"></span>\n        </a>\n      </div>\n    </section>\n\n    <!-- Блок 5: фотографии -->\n    <section class=\"section\" id=\"gallery\" data-block=\"gallery\" aria-labelledby=\"gallery-title\">\n      <div class=\"container\">\n        <h2 id=\"gallery-title\" data-i18n=\"gallery.title\"></h2>\n        <ul class=\"gallery\" id=\"gallery-list\"></ul>\n      </div>\n    </section>\n\n    <!-- Как мы работаем -->\n    <section class=\"section section-soft\" id=\"steps\" data-block=\"steps\" aria-labelledby=\"steps-title\">\n      <div class=\"container narrow\">\n        <h2 id=\"steps-title\" data-i18n=\"steps.title\"></h2>\n        <ol class=\"steps\" id=\"steps-list\"></ol>\n      </div>\n    </section>\n\n    <!-- Видео: загружается с YouTube только по нажатию -->\n    <section class=\"section\" id=\"video\" data-block=\"video\" aria-labelledby=\"video-title\">\n      <div class=\"container narrow\">\n        <h2 id=\"video-title\" data-i18n=\"video.title\"></h2>\n        <div class=\"video-box\" id=\"video-box\">\n          <div class=\"map-placeholder\">\n            <p data-i18n=\"video.note\" data-video-mode=\"youtube\"></p>\n            <p id=\"video-link-note\" data-video-mode=\"link\" hidden></p>\n            <button class=\"btn btn-primary\" type=\"button\" id=\"video-show\" data-video-mode=\"youtube\">\n              <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#i-play\"/></svg>\n              <span data-i18n=\"video.show\"></span>\n            </button>\n            <!-- Видео не с YouTube (Instagram, TikTok…) - ссылка, открывается на том сайте -->\n            <a class=\"btn btn-primary\" id=\"video-link\" data-video-mode=\"link\" target=\"_blank\" rel=\"noopener\" hidden>\n              <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#i-play\"/></svg>\n              <span data-i18n=\"video.show\"></span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Отзывы -->\n    <section class=\"section section-soft\" id=\"reviews\" data-block=\"reviews\" aria-labelledby=\"reviews-title\">\n      <div class=\"container\">\n        <h2 id=\"reviews-title\" data-i18n=\"reviews.title\"></h2>\n        <!-- Отзывы свёрнуты: видны имя и начало, весь текст - по нажатию -->\n        <div class=\"accordion reviews\" id=\"reviews-list\"></div>\n      </div>\n    </section>\n\n    <!-- Блок 6: подробное описание предложений -->\n    <section class=\"section section-soft\" id=\"offers\" data-block=\"offers\" aria-labelledby=\"offers-title\">\n      <div class=\"container narrow\">\n        <h2 id=\"offers-title\" data-i18n=\"offers.title\"></h2>\n        <div class=\"accordion