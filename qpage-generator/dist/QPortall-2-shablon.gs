"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\" data-langs=\"ru,he,en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>QPortall</title>\n  <meta name=\"description\" content=\"\">\n  <meta name=\"theme-color\" content=\"#0b6e69\">\n  <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\n  <link rel=\"icon\" href=\"assets/img/logo.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n  <!-- Выбор языка до показа страницы (бывший lang-early.js). Код встроен, чтобы не ждать отдельный файл;\n       в _headers он разрешён по хэшу sha256 - после любой правки кода хэш нужно пересчитать (тесты это поймают). -->\n  <script>(function () {\n  \"use strict\";\n  try {\n    var html = document.documentElement;\n    var main = html.getAttribute(\"lang\");\n    var langs = (html.getAttribute(\"data-langs\") || main).split(\",\");\n    var pick = null;\n    var fromUrl = new URLSearchParams(window.location.search).get(\"lang\");\n    if (fromUrl && langs.indexOf(fromUrl) !== -1) pick = fromUrl;\n    if (!pick) {\n      var saved = null;\n      try { saved = window.localStorage.getItem(\"qpage-lang\"); } catch (e) { /* хранилище недоступно */ }\n      if (saved && langs.indexOf(saved) !== -1) pick = saved;\n    }\n    if (!pick) {\n      var nav = navigator.languages || [navigator.language || \"\"];\n      for (var i = 0; i < nav.length && !pick; i++) {\n        var code = String(nav[i]).slice(0, 2).toLowerCase();\n        if (code === \"iw\") code = \"he\";\n        if (langs.indexOf(code) !== -1) pick = code;\n      }\n    }\n    // Прячем, только если меняется направление письма (иврит ↔ русский/английский): тогда\n    // отражается вся страница. Русский ↔ английский - просто замена текста, страницу не прячем,\n    // иначе главный текст появляется позже (Google считает это медленной загрузкой, LCP).\n    var rtl = function (l) { return l === \"he\" || l === \"ar\"; };\n    if (pick && pick !== main && rtl(pick) !== rtl(main)) {\n      html.classList.add(\"lang-wait\");\n      // Если скрипт сайта почему-то не сработал - всё равно показать страницу.\n      setTimeout(function () { html.classList.remove(\"lang-wait\"); }, 3000);\n    }\n  } catch (e) { /* старый браузер - страница просто откроется на основном языке */ }\n})();</script>\n</head>\n<body>\n  <!-- Иконки: используются через <use href=\"#i-...\"> -->\n  <svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n    <symbol id=\"i-phone\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z\"/></symbol>\n    <symbol id=\"i-whatsapp\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .78.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.25-.12-1.47-.72-1.7-.8s-.4-.12-.56.12-.64.8-.79.97-.29.18-.54.06a6.7 6.7 0 0 1-3.3-2.9c-.25-.43.25-.4.71-1.33a.45.45 0 0 0-.02-.42c-.06-.12-.56-1.34-.76-1.84s-.4-.42-.56-.43h-.48a.92.92 0 0 0-.66.31 2.8 2.8 0 0 0-.87 2.07 4.85 4.85 0 0 0 1.02 2.58 11.1 11.1 0 0 0 4.25 3.76c1.58.68 2.2.74 2.99.62a2.55 2.55 0 0 0 1.68-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.1-.23-.16-.48-.28z\"/></symbol>\n    <symbol id=\"i-mail\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.3 7l6.7 4.4L18.7 7H5.3z\"/></symbol>\n    <symbol id=\"i-telegram\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M21.4 3.6 2.9 10.7c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.4l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.4-1.5zM8.6 13.3l9.5-6c.5-.3.9-.1.5.2l-8 7.3-.3 3.3-1.7-4.8z