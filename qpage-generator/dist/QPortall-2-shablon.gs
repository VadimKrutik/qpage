act\" method=\"post\" novalidate aria-describedby=\"form-demo-text\">\n          <input type=\"hidden\" name=\"form-name\" value=\"contact\">\n          <!-- Ловушка для ботов: человек это поле не видит -->\n          <p class=\"hp\" aria-hidden=\"true\">\n            <label>Website <input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label>\n          </p>\n\n          <div class=\"error-summary\" id=\"error-summary\" tabindex=\"-1\" role=\"alert\" hidden></div>\n\n          <div class=\"field\">\n            <label for=\"f-name\"><span data-i18n=\"form.name\"></span> <span class=\"req\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\" data-i18n=\"form.required\"></span></label>\n            <input id=\"f-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required minlength=\"2\" maxlength=\"80\" aria-describedby=\"f-name-err\">\n            <p class=\"field-error\" id=\"f-name-err\"></p>\n          </div>\n\n          <div class=\"field\">\n            <label for=\"f-phone\"><span data-i18n=\"form.phone\"></span> <span class=\"req\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\" data-i18n=\"form.required\"></span></label>\n            <input id=\"f-phone\" name=\"phone\" type=\"tel\" dir=\"ltr\" autocomplete=\"tel\" inputmode=\"tel\" required maxlength=\"24\" aria-describedby=\"f-phone-hint f-phone-err\">\n            <p class=\"field-hint\" id=\"f-phone-hint\" data-i18n=\"form.phoneHint\"></p>\n            <p class=\"field-error\" id=\"f-phone-err\"></p>\n          </div>\n\n          <div class=\"field\">\n            <label for=\"f-email\" data-i18n=\"form.email\"></label>\n            <input id=\"f-email\" name=\"email\" type=\"email\" dir=\"ltr\" autocomplete=\"email\" maxlength=\"120\" aria-describedby=\"f-email-hint f-email-err\">\n            <p class=\"field-hint\" id=\"f-email-hint\" data-i18n=\"form.emailHint\"></p>\n            <p class=\"field-error\" id=\"f-email-err\"></p>\n          </div>\n\n          <div class=\"field\">\n            <label for=\"f-message\"><span data-i18n=\"form.message\"></span> <span class=\"req\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\" data-i18n=\"form.required\"></span></label>\n            <textarea id=\"f-message\" name=\"message\" rows=\"5\" required minlength=\"10\" maxlength=\"2000\" aria-describedby=\"f-message-hint f-message-err\"></textarea>\n            <p class=\"field-hint\" id=\"f-message-hint\" data-i18n=\"form.messageHint\"></p>\n            <p class=\"field-error\" id=\"f-message-err\"></p>\n          </div>\n\n          <div class=\"field field-check\">\n            <input id=\"f-consent\" name=\"consent\" type=\"checkbox\" required aria-describedby=\"f-consent-err\">\n            <label for=\"f-consent\"><span id=\"f-consent-text\"></span> <span class=\"req\" aria-hidden=\"true\">*</span></label>\n            <p class=\"field-error\" id=\"f-consent-err\"></p>\n          </div>\n\n          <button class=\"btn btn-primary\" type=\"submit\" id=\"f-submit\" data-i18n=\"form.submit\"></button>\n\n          <div class=\"form-result\" id=\"form-result\" role=\"status\" aria-live=\"polite\"></div>\n          <div class=\"form-wa\" id=\"form-wa\" hidden>\n            <p id=\"form-wa-also\" data-i18n=\"form.waAlso\"></p>\n            <a class=\"btn btn-whatsapp\" id=\"form-wa-link\" target=\"_blank\" rel=\"noopener noreferrer\">\n              <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#i-whatsapp\"/></svg>\n              <span data-i18n=\"form.waButton\"></span>\n            </a>\n          </div>\n        </form>\n      </div>\n    </section>\n\n    <!-- Блок 11: QR-код -->\n    <section class=\"section section-soft\" id=\"qr\" data-block=\"qr\" aria-labelledby=\"qr-title\">\n      <div class=\"container qr-inner\">\n        <div class=\"qr-code\" id=\"qr-code\" role=\"img\" data-i18n-attr=\"aria-label:qr.alt\"></div>\n        <div>\n          <h2 id=\"qr-title\" data-