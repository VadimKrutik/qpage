4H6zm1 1h2v2H7zm3 0h2v2h-2zm2 4a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z\"/></symbol>\n    <symbol id=\"i-fridge\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 2v5h10V4H7zm0 7v9h10v-9H7zm1-6h2v3H8zm0 7h2v4H8z\"/></symbol>\n    <symbol id=\"i-oven\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M5 2h14a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 2v3h14V4H5zm0 5v11h14V9H5zm2 2h10v7H7v-7zm0-6h2v1H7zm4 0h2v1h-2zm4 0h2v1h-2z\"/></symbol>\n    <symbol id=\"i-parts\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M22.7 19 13.6 9.9a6.4 6.4 0 0 0-1.5-6.9A6.6 6.6 0 0 0 4.7 1.7l4.3 4.3-3 3-4.4-4.3a6.6 6.6 0 0 0 1.3 7.4 6.4 6.4 0 0 0 6.9 1.5l9.1 9.1a1 1 0 0 0 1.4 0l2.3-2.3a1 1 0 0 0 .1-1.4z\"/></symbol>\n  </svg>\n\n  <a class=\"skip-link\" href=\"#main\" data-i18n=\"ui.skip\"></a>\n\n  <aside class=\"demo-notice\" id=\"demo-notice\" data-i18n-attr=\"aria-label:ui.demoLabel\" hidden>\n    <p data-i18n=\"ui.demoNotice\"></p>\n  </aside>\n\n  <header class=\"site-header\">\n    <div class=\"container header-inner\">\n      <a class=\"brand\" href=\"#top\" id=\"brand-link\">\n        <img class=\"brand-logo\" src=\"assets/img/logo.svg\" alt=\"\" width=\"40\" height=\"40\" data-logo>\n        <span class=\"brand-name\" data-i18n=\"hero.name\"></span>\n      </a>\n\n      <button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-nav\" id=\"menu-toggle\">\n        <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#i-menu\"/></svg>\n        <span class=\"visually-hidden\" id=\"menu-toggle-label\" data-i18n=\"ui.menuOpen\"></span>\n      </button>\n\n      <nav class=\"site-nav\" id=\"site-nav\" data-i18n-attr=\"aria-label:ui.nav\">\n        <ul>\n          <li data-block=\"about\"><a href=\"#about\" data-i18n=\"ui.navAbout\"></a></li>\n          <li data-block=\"services\"><a href=\"#services\" data-i18n=\"ui.navServices\"></a></li>\n          <li data-block=\"pricelist\"><a href=\"#pricelist\" data-i18n=\"ui.navPrices\"></a></li>\n          <li data-block=\"gallery\"><a href=\"#gallery\" data-i18n=\"ui.navGallery\"></a></li>\n          <li data-block=\"reviews\"><a href=\"#reviews\" data-i18n=\"ui.navReviews\"></a></li>\n          <li data-block=\"offers\"><a href=\"#offers\" data-i",
"18n=\"ui.navOffers\"></a></li>\n          <li data-block=\"contacts\"><a href=\"#contacts\" data-i18n=\"ui.navContacts\"></a></li>\n        </ul>\n      </nav>\n\n      <div class=\"lang-switch\" role=\"group\" data-i18n-attr=\"aria-label:ui.language\" id=\"lang-switch\">\n        <button type=\"button\" data-lang=\"ru\" lang=\"ru\" aria-label=\"RU, Русский\">RU</button>\n        <button type=\"button\" data-lang=\"he\" lang=\"he\" aria-label=\"HE, עברית\">HE</button>\n        <button type=\"button\" data-lang=\"en\" lang=\"en\" aria-label=\"EN, English\">EN</button>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"main\" tabindex=\"-1\">\n    <noscript><p class=\"container noscript\" data-i18n=\"ui.noscript\">Для переключения языка и работы формы включите JavaScript.</p></noscript>\n\n    <!-- Блоки 1-2: одинаковые во всех версиях. Сверху - цветная заливка: фото владельца слева (если есть),\n         по центру три строки - вид деятельности, название, преимущества. Ниже - «Где работаем» и кнопки,\n         под ними главное предложение, ещё ниже - главное фото крупно. -->\n    <section class=\"hero\" id=\"top\" aria-labelledby=\"hero-title\">\n      <div class=\"hero-banner\">\n        <div class=\"container\">\n          <!-- Вид деятельности - в заголовке вместе с названием: так поисковик видит, чем занимается бизнес -->\n          <h1 id=\"hero-title\"><span class=\"hero-kind\" data-i18n=\"hero.kind\"></span> <span class=\"hero-name\" data-i18n=\"hero.name\"></span></h1>\n          <ul class=\"hero-facts\" id=\"hero-facts\"></ul>\n        </div>\n      </div>\n      <div class=\"container hero-body\">\n        <!-- На телефоне преимущества стоят здесь, под цветной заливкой: в заливке только фото и название -->\n        <ul class=\"hero-facts hero-facts-below\" id=\"hero-facts-below\"></ul>\n        <div class=\"hero-more\">\n          <!-- Районы выезда - сразу на первом экране, чтобы клиент видел, приедут ли к нему -->\n          <p class=\"hero-areas\" id